<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>voxcpm-tts</AssemblyName>
    <RootNamespace>VoxCpm.Cli</RootNamespace>
    <!-- Native libtorch backend: cpu (default) or cuda. Build with -p:TorchBackend=cuda for NVIDIA GPUs. -->
    <TorchBackend Condition="'$(TorchBackend)' == ''">cpu</TorchBackend>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxCpm\VoxCpm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Link="license\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE" Link="license\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TorchBackend)' == 'cpu'">
    <PackageReference Include="TorchSharp-cpu" Version="0.107.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TorchBackend)' == 'cuda' And $([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="TorchSharp-cuda-windows" Version="0.107.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TorchBackend)' == 'cuda' And $([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="TorchSharp-cuda-linux" Version="0.107.0" />
  </ItemGroup>

</Project>
